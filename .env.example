# Copy to .env for local Quarkus development. Never commit real values.
# Tests require TEST_* exported in the process environment.
DB_JDBC_URL=jdbc:postgresql://localhost:5432/phonezone_db
DB_USERNAME=postgres
DB_PASSWORD=change-me-local-only

# Optional cache. Production defaults to false if this variable is absent.
CATALOG_CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
CATALOG_CACHE_NAMESPACE=phonezone:catalog:dev:v1
CATALOG_CACHE_TTL=60s

# Generate: node scripts/setup-dev-keys.mjs
JWT_PUBLIC_KEY_LOCATION=.local/keys/publicKey.pem
JWT_PRIVATE_KEY_LOCATION=.local/keys/privateKey.pem
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Production: PORT comes from Render; see docs/deployment.md.
# Generate SEPARATE keys: node scripts/setup-dev-keys.mjs --production
# JWT_PUBLIC_KEY_LOCATION=/etc/secrets/publicKey.pem
# JWT_PRIVATE_KEY_LOCATION=/etc/secrets/privateKey.pem
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_USERNAME=your_admin_username
# BOOTSTRAP_ADMIN_EMAIL=your_admin_email
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters

# Leave credentials empty while the VNPay sandbox is unavailable.
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_RETURN_URL=http://localhost:8080/api/payment/vnpay-return

# DISPOSABLE services only. Tests recreate schema and pause Redis.
TEST_DB_JDBC_URL=jdbc:postgresql://localhost:5432/phonezone_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=change-me-local-only
TEST_REDIS_URL=redis://localhost:6380
